#!/bin/bash
# knulli-input-tester.gptk - PortMaster ToolKit configuration file
# This file integrates knulli-input-tester with PortMaster package manager

# PortMaster configuration
PT_VERSION="1.0.0"
PT_LAUNCHER_VERSION="v2.4.0"
PT_REPO_BRANCH="main"

# Application metadata
PT_TITLE="Knulli Input Tester"
PT_DESC="Real-time input device tester and event visualizer for Knulli OS"
PT_AUTHOR="Knulli Community"
PT_CATEGORY="Utilities/System Tools"
PT_RUNTIME="native"
PT_ARCH="arm64"

# Port installation paths
# These tell PortMaster where files should be installed
PT_PATH_GAME="/roms/ports/knulli-input-tester"
PT_PATH_CONFIG="/roms/ports/knulli-input-tester/config"
PT_PATH_SAVES="/roms/ports/knulli-input-tester/saves"
PT_PATH_BACKUP="/roms/ports/.backup/knulli-input-tester"

# Executable
PT_LAUNCH="knulli-input-tester.sh"
PT_LAUNCH_PATH="${PT_PATH_GAME}/${PT_LAUNCH}"

# Port information
PT_DEPENDS="libevdev, SDL2"
PT_INSTALL_TYPE="binary"
PT_SIZE="2MB"
PT_MEMORY_MIN="50MB"

# Launcher options
PT_LAUNCHER_OPTS="--pause=emulationstation --max-cpu=90"

# Desktop integration
PT_DESKTOP_ENTRY=true
PT_DESKTOP_ICON="icon.png"
PT_DESKTOP_CATEGORIES="System;Utility;"

# Build information  
PT_BUILD_DATE="2025-11-20"
PT_BUILD_OS="Linux ARM64"
PT_BUILD_COMPILER="aarch64-linux-gnu-gcc (GCC 11.2+)"

# Source code
PT_SOURCE_URL="https://github.com/jellydn/knulli-input-tester"
PT_SOURCE_COMMIT="@GIT_COMMIT@"
PT_LICENSE="MIT"

# Version constraints
PT_REQUIRES_PORTMASTER="2.0.0+"
PT_REQUIRES_KNULLI="0.5.0+"
PT_REQUIRES_OS="Linux ARM64"

# Features
PT_FEATURES=(
    "Real-time input monitoring"
    "Multiple controller support"
    "Event history and logging"
    "Button mapping"
    "Performance monitoring"
    "Configurable display modes"
)

# Pre-launch checks
PT_PRELAUNCH_CHECKS=(
    "libevdev"
    "SDL2"
    "framebuffer"
)

# Post-launch cleanup
PT_POSTLAUNCH_CLEANUP=(
    "remove_temp_files"
    "restore_emulationstation"
)

# Configuration defaults
PT_CONFIG_DEFAULTS=(
    "display_mode=auto"
    "button_scheme=knulli"
    "history_size=1000"
    "refresh_rate=60"
    "performance_monitor=enabled"
)

# Notes
PT_NOTES="
First run may take a few seconds to detect controllers.
Use the settings menu to configure display and input options.
Logs are saved to: /roms/ports/knulli-input-tester/logs/

For troubleshooting, check the launcher log:
tail -f /roms/ports/knulli-input-tester/logs/launcher.log
"

# Changelog
PT_CHANGELOG="
v1.0.0 - Initial PortMaster release
- Cross-compilation for ARM64 architecture
- PortMaster integration with EmulationStation
- Dependency checking and runtime verification
- Static linking for portability
"

# Contact information
PT_CONTACT_DEV="Knulli Community"
PT_CONTACT_EMAIL="development@knulli.org"
PT_CONTACT_GITHUB="https://github.com/jellydn/knulli-input-tester"
PT_CONTACT_ISSUES="https://github.com/jellydn/knulli-input-tester/issues"

# PortMaster integration
# These functions are called by PortMaster during installation/execution

# Function: Called before installation
portmaster_before_install() {
    echo "Preparing Knulli Input Tester installation..."
    # Check disk space
    # Check dependencies
    # Create directories
}

# Function: Called after installation  
portmaster_after_install() {
    echo "Finalizing Knulli Input Tester installation..."
    # Set up config
    # Create shortcuts
    # Initialize logs
}

# Function: Called before launch
portmaster_before_launch() {
    echo "Pre-launch checks for Knulli Input Tester..."
    # Verify binary format
    # Check dependencies
    # Pause EmulationStation
}

# Function: Called after exit
portmaster_after_exit() {
    echo "Cleanup after Knulli Input Tester..."
    # Resume EmulationStation
    # Clean temp files
    # Archive logs
}

# Metadata end
__GPTK_END__
